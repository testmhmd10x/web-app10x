{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app10x",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b6ea5fa2-383e-4b1f-a325-a4ed61f85b87","database_name": "web-app10x" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b281c55c3de44fae96bce7d57803d836" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
